%% Hydrogen MFC Fill Calculator
%% Objective
% Example wrapper for the reusable hydrogen fill calculator function.
% Edit the inputs for one test, run the script, and the function returns the
% required hydrogen amount and optional filling time estimate.

clearvars; clc; close all;
format short eng

%% Add Auxiliary Functions
thisFileDir = fileparts(mfilename('fullpath'));
projectRootDir = fileparts(fileparts(thisFileDir));
auxDir = fullfile(projectRootDir, 'Auxilliary_Functions', 'EMP2X-Project');
addpath(auxDir);

%% Example Test Inputs
% Scalars are applied to all rows. Vectors must have the same length as
% H2_volPct so each concentration can use its own test conditions.
L = 0.9; % Length (L)
W = 0.9; % Width (W)
H = 0.9; % Height (H)
Vol_Pipes = 0;                                       % pipes added free volume [m^3]
V_chamber_m3 = L * W * H + Vol_Pipes;                    % chamber free volume [m^3]

T_local_K = [292.95 293.25 293.55 293.15 294.35 294.15 293.85 294.05]; ...
    % per-test gas temperature [K]
P_final_Pa = [101325 101325 101280 101310 101420 101390 101340 101360]; ...
    % per-test final absolute pressure [Pa]
H2_volPct = [4 5 10 15 18 20 25 30];                             % target hydrogen concentration [vol%]

fillMode = 'vented';                     % 'vented' or 'sealed'
P0_Pa = 101325;                          % initial chamber pressure [Pa], sealed mode only

T_std_K = 298.15;                        % Alicat default standard temperature [K]
P_std_Pa = 101325;                       % standard absolute pressure [Pa]
MFC_setpoint_std_m3_s = NaN;             % standardized MFC setpoint [m^3/s], use NaN to skip fill time

% If you have an Alicat setpoint in SLPM, convert it before calling:
% Alicat_setpoint_SLPM = 10.0;
% MFC_setpoint_std_m3_s = Alicat_setpoint_SLPM * 1e-3 / 60;

makePlot = true;                         % true to generate the mass plot

%% Run Calculator
Results = AuxFcn_H2_MFC_FillCalculator_000( ...
    V_chamber_m3, ...
    T_local_K, ...
    P_final_Pa, ...
    H2_volPct, ...
    fillMode, ...
    P0_Pa, ...
    T_std_K, ...
    P_std_Pa, ...
    MFC_setpoint_std_m3_s, ...
    makePlot);

%% Display Results
disp(' ');
disp('Hydrogen MFC fill calculation results:')

if isfield(Results, 'table')
    disp(Results.table)
else
    disp(strjoin(Results.headers, ' | '))
    disp(Results.data)
end

fprintf('\nInputs used:\n');
fprintf('  Fill mode           : %s\n', Results.inputs.fillMode);
fprintf('  Standard reference  : %.2f K and %.0f Pa\n', ...
    Results.inputs.T_std_K, Results.inputs.P_std_Pa);

if numel(unique(Results.V_chamber_m3)) == 1
    fprintf('  Chamber volume      : %.5f m^3 (shared)\n', Results.V_chamber_m3(1));
else
    fprintf('  Chamber volume      : row-specific values in Results table\n');
end

if numel(unique(Results.T_local_K)) == 1
    fprintf('  Local temperature   : %.2f K (shared)\n', Results.T_local_K(1));
else
    fprintf('  Local temperature   : row-specific values in Results table\n');
end

if numel(unique(Results.P_final_Pa)) == 1
    fprintf('  Final pressure      : %.0f Pa (shared)\n', Results.P_final_Pa(1));
else
    fprintf('  Final pressure      : row-specific values in Results table\n');
end

if all(isfinite(Results.inputs.MFC_setpoint_std_m3_s)) && all(Results.inputs.MFC_setpoint_std_m3_s > 0) ...
        && numel(unique(Results.inputs.MFC_setpoint_std_m3_s)) == 1
    fprintf('  MFC setpoint        : %.6e m^3/s at standard conditions (shared)\n', ...
        Results.inputs.MFC_setpoint_std_m3_s(1));
elseif all(~isfinite(Results.inputs.MFC_setpoint_std_m3_s) | Results.inputs.MFC_setpoint_std_m3_s <= 0)
    fprintf('\nFill time not calculated because MFC_setpoint_std_m3_s is NaN or <= 0.\n');
else
    fprintf('  MFC setpoint        : row-specific values used where available\n');
end

%% Example for Multiple Tests
% testTemperatures_K = [291.65 294.15 297.15];
% for iTest = 1:numel(testTemperatures_K)
%     testResult = AuxFcn_H2_MFC_FillCalculator_000( ...
%         V_chamber_m3, testTemperatures_K(iTest), P_final_Pa(iTest), ...
%         18, fillMode, P0_Pa, T_std_K, P_std_Pa, ...
%         MFC_setpoint_std_m3_s, false);
%     fprintf('Test %d -> T = %.2f K, required H2 = %.6f kg\n', ...
%         iTest, testTemperatures_K(iTest), testResult.m_H2_kg);
% end
