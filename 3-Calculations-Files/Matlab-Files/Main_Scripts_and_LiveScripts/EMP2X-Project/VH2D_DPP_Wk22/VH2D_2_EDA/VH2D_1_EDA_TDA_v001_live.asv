title(axFull,{'Preprocessed: Pressure $\&$ Trigger Signal',}, 'Interpreter', 'latex'); %[output:443c3f8f]

legend(axFull,[hP1,hP2,hTr1,hTr2], ... %[output:443c3f8f]
    {'Pressure (DAQ-1) '+ ch1_p,'Pressure (DAQ-4) ' + ch2_p,'Trigger (DAQ-1) ' + ch1_tr,'Trigger (DAQ-4) ' + ch2_tr}, ... %[output:443c3f8f]
    'Location','northeast', 'Interpreter','latex'); %[output:443c3f8f]

grid(axFull,'on'); %[output:443c3f8f]
hold(axFull,'off') %[output:443c3f8f]
