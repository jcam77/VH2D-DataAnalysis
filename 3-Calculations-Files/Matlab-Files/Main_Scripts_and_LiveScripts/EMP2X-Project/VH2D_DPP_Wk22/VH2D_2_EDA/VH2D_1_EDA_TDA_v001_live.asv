hold(axFull,'on'); %[output:443c3f8f]
hP2 = plot(axFull, t2, y2_p, 'Color', LUCopper, 'LineStyle', '-', 'LineWidth', 0.5); %[output:443c3f8f]
ylabel(axFull, "Overpressure [kPa]", 'Interpreter', 'latex'); %[output:443c3f8f]
axFull.YColor = 'k'; %[output:443c3f8f]
% Right axis: triggers
