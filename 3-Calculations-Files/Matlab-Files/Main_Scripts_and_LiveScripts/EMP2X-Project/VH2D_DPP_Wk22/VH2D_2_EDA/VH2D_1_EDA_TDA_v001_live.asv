%[text] # **Vented Hydrogen Deflagration Experiments**
%[text] # **Preliminary Results Campaign Week 22 2026**
%[text] %[text:anchor:T_D5D49718] # Data Processing Procedure (DPP)
%%
%[text] # **Exploratory Data Analysis (EDA)**
%[text] # Time Domain Analysis (EDA-TDA)
%%
%[text] %[text:anchor:H_23C559C1] ## 1. Setup (Matlab Startup File)
%[text] %[text:anchor:H_1B29D089] This m-File code prepare the environment to provide access to auxiliary files and sub-folders.
clear ; clc; close all;
format short eng
scriptRoot = fileparts(mfilename("fullpath"));
[projectRoot,AuxFcn_GS] = AuxFcn_Matlab_Startup_File_001;
auxRoot = fullfile(projectRoot, ...
    "3-Calculations-Files", "Matlab-Files", "Auxilliary_Functions");
mainFcnRoot = fullfile(projectRoot, ...
    "3-Calculations-Files", "Matlab-Files", "Main_Functions");
addpath(genpath(auxRoot));
addpath(genpath(mainFcnRoot));
%[text] #### Plots and Names Convention
%[text] Figures are identified using a compact and traceable name. The same convention will be used throughout preprocessing, exploratory data analysis, filtering, and QoI extraction:
%[text] `Fig-<Run>-<Comparison>-<Stage>-<Purpose>-F<NN>-<Detail>`
%[text] **Stage codes**
%[text] - `RAW`: raw data overview and loading diagnostics
%[text] - `PP`: pressure/trigger preprocessing
%[text] - `EDA`: exploratory data analysis
%[text] - `FILT`: filtering and sensitivity analysis
%[text] - `QOI`: quantity-of-interest extraction \
%[text] **Figure number**
%[text] - `F01`, `F02`, `F03`, ... identify multiple figures within the same run/section.
%[text] - `F` is used instead of `P` to avoid confusion with pressure sensor IDs such as `P3`, `P5`, or `P7`. \
%[text] **Examples**
%[text] - `Fig-Wk22-02-01-LUvsKistler-PP-WoI-F01-Flush`
%[text] - `Fig-Wk22-02-02-LUvsKistler-PP-WoI-F01-Flush`
%[text] - `Fig-Wk22-03-01-LUvsDBI-PP-F01-MountingMethods`
%[text] - `Fig-Wk22-03-01-LUvsDBI-PP-WoI-F02-Recessed`
%[text] - `Fig-Wk22-03-01-LUvsDBI-PP-WoI-F03-FlushBlind` \
%[text] **Future examples for later sections**
%[text] - `Fig-Wk22-03-01-LUvsDBI-EDA-FFT-F01-AllComparable`
%[text] - `Fig-Wk22-03-01-LUvsDBI-FILT-Sensitivity-F01-P5`
%[text] - `Fig-Wk22-03-QOI-Summary-F01-Pmax` \
%[text] In MATLAB, the figure ID should be assigned to the figure `Name` property, while the visible plot title can remain more descriptive for the report.
set(groot, 'defaultTextInterpreter', 'latex', 'defaultAxesTickLabelInterpreter','latex', 'defaultLegendInterpreter','latex');
LUCopper = [147, 86, 14]/255;LUCopper_Light = [225, 213, 199]/255;LUBlue = [17, 55, 125]/255;LUBlue_Light = [197, 204, 221]/255;
Red_Dark = [192, 0, 0]/255;Red_Light = [235, 200, 197]/255;pink = [255, 199, 206]/255;skyblue_light=[183/255 236/255 255/255];

%[text] ## 2. Load Data Preparation File
load('DPR_VH2D_Wk22_Groups_02_03_04.mat')
load('gasMixingTable_VH2D_Wk22_Groups_02_03_04.mat')
load('sensorMappingTable_VH2D_Wk22_Groups_02_03_04.mat')
%[text] ### Prepared Data by Groups
%[text] Pressure & Concentration (Under Construction!!!)
%[text] #### **Group VH2D-Wk22-02 (LU vs Kistler)**
group = DPR_VH2D_Wk22_Groups_02_03_04.groups.Group_02;
run_Wk22_02_01 = group.runs.VH2D_Wk22_02_01;
run_Wk22_02_02 = group.runs.VH2D_Wk22_02_02;
run_Wk22_02_03 = group.runs.VH2D_Wk22_02_03;
run_Wk22_02_04 = group.runs.VH2D_Wk22_02_04;
%[text] #### **Group VH2D-Wk22-03 (LU vs DBI)**
group = DPR_VH2D_Wk22_Groups_02_03_04.groups.Group_03;
run_Wk22_03_01 = group.runs.VH2D_Wk22_03_01;
run_Wk22_03_02 = group.runs.VH2D_Wk22_03_02;
run_Wk22_03_03 = group.runs.VH2D_Wk22_03_03;
run_Wk22_03_04 = group.runs.VH2D_Wk22_03_04;
run_Wk22_03_05 = group.runs.VH2D_Wk22_03_05;
%[text] #### **Group VH2D-Wk22-04 (LU vs DBI)**
group = DPR_VH2D_Wk22_Groups_02_03_04.groups.Group_04;
run_Wk22_04_01 = group.runs.VH2D_Wk22_04_01;
run_Wk22_04_02 = group.runs.VH2D_Wk22_04_02;
run_Wk22_04_03 = group.runs.VH2D_Wk22_04_03;
run_Wk22_04_04 = group.runs.VH2D_Wk22_04_04;
run_Wk22_04_05 = group.runs.VH2D_Wk22_04_05;
%[text] ## 3. Plot Preprocessed Data
%[text] ### **3.1 Group VH2D-Wk22-02 (LU vs Kistler)**
%[text] #### **Run Wk22-02-01**
% --- Run Wk22-02-01: Single Figure / 2 Tiles with Dynamic Axis Limits ---
% DAQ-1
t1 = run_Wk22_02_01.DAQ_1.t_s;
y1_p = run_Wk22_02_01.DAQ_1.signal(:,1);
ch1_p = run_Wk22_02_01.DAQ_1.channels(1);
y1_tr = run_Wk22_02_01.DAQ_1.signal(:,2);
ch1_tr = run_Wk22_02_01.DAQ_1.channels(2);

% DAQ-4
t2 = run_Wk22_02_01.DAQ_4.t_s;
y2_p = run_Wk22_02_01.DAQ_4.signal(:,1);
ch2_p = run_Wk22_02_01.DAQ_4.channels(1);
y2_tr = run_Wk22_02_01.DAQ_4.signal(:,2);
ch2_tr = run_Wk22_02_01.DAQ_4.channels(2);

% Define Window Of Interest (WoI) explicitly (seconds)
LB_WoI = 0;% in seconds
UB_WoI = 0.25;% in seconds
WoI = [LB_WoI, UB_WoI];  % in seconds

% Create 2x1 tiled figure and naming
figId = "Fig-Wk22-02-01-LUvsKistler-PP-WoI-F01-Flush";
fig = figure( ... %[output:15bf0809]
    'Name', figId, ... %[output:15bf0809]
    'NumberTitle', 'off', ... %[output:15bf0809]
    'Units','centimeters', ... %[output:15bf0809]
    'Position',[10 10 36 20]); %[output:15bf0809]

tiled = tiledlayout(2,1,'TileSpacing','compact','Padding','compact'); %[output:15bf0809]
% Upper tile: pressures & triggers
% Left axis: pressures
axFull = nexttile; %[output:15bf0809]
yyaxis(axFull, 'left'); %[output:15bf0809]
hP1 = plot(axFull, t1, y1_p, 'Color', LUBlue, 'LineStyle', '-', 'LineWidth', 0.5);  %[output:15bf0809]
hold(axFull,'on'); %[output:15bf0809]
hP2 = plot(axFull, t2, y2_p, 'Color', LUCopper, 'LineStyle', '-', 'LineWidth', 0.5); %[output:15bf0809]
ylabel(axFull, "Overpressure [kPa]", 'Interpreter', 'latex'); %[output:15bf0809]
axFull.YColor = 'k'; %[output:15bf0809]
% Right axis: triggers
yyaxis(axFull, 'right'); %[output:15bf0809]
hTr1 = plot(axFull, t1, y1_tr, 'Color', Red_Dark, 'LineStyle', '-', 'LineWidth', 0.5);  %[output:15bf0809]
hold(axFull,'on'); %[output:15bf0809]
hTr2 = plot(axFull, t2, y2_tr, 'Color', Red_Light, 'LineStyle', ':', 'LineWidth', 0.5); %[output:15bf0809]
ylabel(axFull, 'Trigger Voltage [V]', 'Interpreter', 'latex'); %[output:15bf0809]
axFull.YColor = Red_Dark; %[output:15bf0809]
% Common formatting
xlabel(axFull,'Time [s]', 'Interpreter', 'latex'); %[output:15bf0809]
title(axFull,{'Preprocessed: Pressure $\&$ Trigger Signal',}, 'Interpreter', 'latex'); %[output:15bf0809]

legend(axFull,[hP1,hP2,hTr1,hTr2], ... %[output:15bf0809]
    {'Pressure (DAQ-1) '+ ch1_p,'Pressure (DAQ-4) ' + ch2_p,'Trigger (DAQ-1) ' + ch1_tr,'Trigger (DAQ-4) ' + ch2_tr}, ... %[output:15bf0809]
    'Location','northeast', 'Interpreter','latex'); %[output:15bf0809]

grid(axFull,'on'); %[output:15bf0809]
hold(axFull,'off') %[output:15bf0809]
% pbaspect(axFull, [16 9 1]);
% axFull.PlotBoxAspectRatioMode = 'manual';

% --- Dynamic axis limits (5% padding) ---
padFrac = 0.05;

% X limits combining t1 and t2
tAll = [t1(:); t2(:)];
tMin = min(tAll); tMax = max(tAll);
tRange = tMax - tMin;
if tRange == 0
    tPad = abs(tMin)*padFrac + 1e-3;
else
    tPad = padFrac * tRange;
end
xlim(axFull, [tMin - tPad, tMax + tPad]); %[output:15bf0809]

% Left axis (pressures)
pAll = [y1_p(:); y2_p(:)];
pMin = min(pAll); pMax = max(pAll);
pRange = pMax - pMin;
if pRange == 0
    pPad = abs(pMin)*padFrac + 1e-3;
else
    pPad = padFrac * pRange;
end
yyaxis(axFull, 'left'); %[output:15bf0809]
ylim(axFull, [pMin - pPad, pMax + pPad]); %[output:15bf0809]

% Right axis (triggers)
trAll = [y1_tr(:); y2_tr(:)];
trMin = min(trAll); trMax = max(trAll);
trRange = trMax - trMin;
if trRange == 0
    trPad = abs(trMin)*padFrac + 1e-3;
else
    trPad = padFrac * trRange;
end
yyaxis(axFull, 'right'); %[output:15bf0809]
ylim(axFull, [trMin - trPad, trMax + trPad]); %[output:15bf0809]
box on %[output:15bf0809]

% Bottom tile: Window Of Interest (pressures only)
axWoI = nexttile; %[output:15bf0809]
% --- Logical indexing first (strict interval) ---
idx1 = find(t1 >= WoI(1) & t1 <= WoI(2));
idx2 = find(t2 >= WoI(1) & t2 <= WoI(2));

% --- Fallback to nearest-index if logical indexing yields empty
if isempty(idx1)
    [~, i0] = min(abs(t1 - WoI(1)));
    [~, i1] = min(abs(t1 - WoI(2)));
    idx1 = min(i0,i1):max(i0,i1);
end
if isempty(idx2)
    [~, j0] = min(abs(t2 - WoI(1)));
    [~, j1] = min(abs(t2 - WoI(2)));
    idx2 = min(j0,j1):max(j0,j1);
end


% Ensure non-empty before plotting
hold(axWoI,'on'); %[output:15bf0809]
if ~isempty(idx1)
    axWoIhP1 = plot(axWoI, t1(idx1), y1_p(idx1), '-', 'Color', LUBlue, 'LineWidth', 0.9); %[output:15bf0809]
end
if ~isempty(idx2)
    axWoIhP2 = plot(axWoI, t2(idx2), y2_p(idx2), '-', 'Color', LUCopper, 'LineWidth', 0.9); %[output:15bf0809]
end
xlabel(axWoI, 'Time [s]', 'Interpreter','latex'); %[output:15bf0809]
ylabel(axWoI, 'Overpressure [kPa]', 'Interpreter','latex'); %[output:15bf0809]
legend(axWoI,[axWoIhP1,axWoIhP2], ... %[output:15bf0809]
    {'Pressure (DAQ-1) '+ ch1_p,'Pressure (DAQ-4) ' + ch2_p}, ... %[output:15bf0809]
    'Location','northeast', 'Interpreter','latex'); %[output:15bf0809]
title(axWoI, sprintf('Temporal Window of Interest: [%.3f, %.3f] s', WoI(1), WoI(2)), 'Interpreter','latex'); %[output:15bf0809]
xlim(axWoI, WoI);  %[output:15bf0809]
% --- Dynamic axis limits (5% padding) ---
padFrac = 0.05;

% X limits combining t1 and t2
tAll = [t1(idx1); t2(idx2)];
tMin = min(tAll); tMax = max(tAll);
tRange = tMax - tMin;
if tRange == 0
    tPad = abs(tMin)*padFrac + 1e-3;
else
    tPad = padFrac * tRange;
end
xlim(axWoI, [tMin - tPad, tMax + tPad]); %[output:15bf0809]

% Left axis (pressures)
pAll = [y1_p(:); y2_p(:)];
pMin = min(pAll); pMax = max(pAll);
pRange = pMax - pMin;
if pRange == 0
    pPad = abs(pMin)*padFrac + 1e-3;
else
    pPad = padFrac * pRange;
end
ylim(axWoI, [pMin - pPad, pMax + pPad]); %[output:15bf0809]
grid(axWoI,'on'); %[output:15bf0809]
hold(axWoI,'off'); %[output:15bf0809]
% pbaspect(axFull, [16 9 1]);
% axFull.PlotBoxAspectRatioMode = 'manual';
box on %[output:15bf0809]
% Add a single shared title above the two tiles
sgtitle(tiled, {"{\textbf{Run Wk22-02-01 (Conc. Target $H_2$ 18 vol.$\%$)}}",'LU vs Kistler DAQs (Flush Mounted Pressure Sensors + RTV)'}, 'Interpreter', 'latex'); %[output:15bf0809]
% close all
%[text] #### **Run Wk22\_02\_02**
% --- Run Wk22-02-02: Single Figure / 2 Tiles with Dynamic Axis Limits ---
% DAQ-1
t1 = run_Wk22_02_02.DAQ_1.t_s;
y1_p = run_Wk22_02_02.DAQ_1.signal(:,1);
ch1_p = run_Wk22_02_02.DAQ_1.channels(1);
y1_tr = run_Wk22_02_02.DAQ_1.signal(:,2);
ch1_tr = run_Wk22_02_02.DAQ_1.channels(2);

% DAQ-4
t2 = run_Wk22_02_02.DAQ_4.t_s;
y2_p = run_Wk22_02_02.DAQ_4.signal(:,1);
ch2_p = run_Wk22_02_02.DAQ_4.channels(1);
y2_tr = run_Wk22_02_02.DAQ_4.signal(:,2);
ch2_tr = run_Wk22_02_02.DAQ_4.channels(2);

% Define Window Of Interest (WoI) explicitly (seconds)
LB_WoI = 0;% in seconds
UB_WoI = 0.25;% in seconds
WoI = [LB_WoI, UB_WoI];  % in seconds

% Create 2x1 tiled figure and naming
figId = "Fig-Wk22-02-02-LUvsKistler-PP-WoI-F01-Flush";
fig = figure( ... %[output:772fd63a]
    'Name', figId, ... %[output:772fd63a]
    'NumberTitle', 'off', ... %[output:772fd63a]
    'Units','centimeters', ... %[output:772fd63a]
    'Position',[10 10 36 20]); %[output:772fd63a]
tiled = tiledlayout(2,1,'TileSpacing','compact','Padding','compact'); %[output:772fd63a]

% Upper tile: pressures & triggers
% Left axis: pressures
axFull = nexttile; %[output:772fd63a]
yyaxis(axFull, 'left'); %[output:772fd63a]
hP1 = plot(axFull, t1, y1_p, 'Color', LUBlue, 'LineStyle', '-', 'LineWidth', 0.5);  %[output:772fd63a]
hold(axFull,'on'); %[output:772fd63a]
hP2 = plot(axFull, t2, y2_p, 'Color', LUCopper, 'LineStyle', '-', 'LineWidth', 0.5); %[output:772fd63a]
ylabel(axFull, "Overpressure [kPa]", 'Interpreter', 'latex'); %[output:772fd63a]
axFull.YColor = 'k'; %[output:772fd63a]
% Right axis: triggers
yyaxis(axFull, 'right'); %[output:772fd63a]
hTr1 = plot(axFull, t1, y1_tr, 'Color', Red_Dark, 'LineStyle', '-', 'LineWidth', 0.5);  %[output:772fd63a]
hold(axFull,'on'); %[output:772fd63a]
hTr2 = plot(axFull, t2, y2_tr, 'Color', Red_Light, 'LineStyle', ':', 'LineWidth', 0.5); %[output:772fd63a]
ylabel(axFull, 'Trigger Voltage [V]', 'Interpreter', 'latex'); %[output:772fd63a]
axFull.YColor = Red_Dark; %[output:772fd63a]
% Common formatting
xlabel(axFull,'Time [s]', 'Interpreter', 'latex'); %[output:772fd63a]
title(axFull,{'Preprocessed: Pressure $\&$ Trigger Signal',}, 'Interpreter', 'latex'); %[output:772fd63a]

legend(axFull,[hP1,hP2,hTr1,hTr2], ... %[output:772fd63a]
    {'Pressure (DAQ-1) '+ ch1_p,'Pressure (DAQ-4) ' + ch2_p,'Trigger (DAQ-1) ' + ch1_tr,'Trigger (DAQ-4) ' + ch2_tr}, ... %[output:772fd63a]
    'Location','northeast', 'Interpreter','latex'); %[output:772fd63a]

grid(axFull,'on'); %[output:772fd63a]
hold(axFull,'off') %[output:772fd63a]
% pbaspect(axFull, [16 9 1]);
% axFull.PlotBoxAspectRatioMode = 'manual';

% --- Dynamic axis limits (5% padding) ---
padFrac = 0.05;

% X limits combining t1 and t2
tAll = [t1(:); t2(:)];
tMin = min(tAll); tMax = max(tAll);
tRange = tMax - tMin;
if tRange == 0
    tPad = abs(tMin)*padFrac + 1e-3;
else
    tPad = padFrac * tRange;
end
xlim(axFull, [tMin - tPad, tMax + tPad]); %[output:772fd63a]

% Left axis (pressures)
pAll = [y1_p(:); y2_p(:)];
pMin = min(pAll); pMax = max(pAll);
pRange = pMax - pMin;
if pRange == 0
    pPad = abs(pMin)*padFrac + 1e-3;
else
    pPad = padFrac * pRange;
end
yyaxis(axFull, 'left'); %[output:772fd63a]
ylim(axFull, [pMin - pPad, pMax + pPad]); %[output:772fd63a]

% Right axis (triggers)
trAll = [y1_tr(:); y2_tr(:)];
trMin = min(trAll); trMax = max(trAll);
trRange = trMax - trMin;
if trRange == 0
    trPad = abs(trMin)*padFrac + 1e-3;
else
    trPad = padFrac * trRange;
end
yyaxis(axFull, 'right'); %[output:772fd63a]
ylim(axFull, [trMin - trPad, trMax + trPad]); %[output:772fd63a]
box on %[output:772fd63a]

% Bottom tile: Window Of Interest (pressures only)
axWoI = nexttile; %[output:772fd63a]
% --- Logical indexing first (strict interval) ---
idx1 = find(t1 >= WoI(1) & t1 <= WoI(2));
idx2 = find(t2 >= WoI(1) & t2 <= WoI(2));

% --- Fallback to nearest-index if logical indexing yields empty
if isempty(idx1)
    [~, i0] = min(abs(t1 - WoI(1)));
    [~, i1] = min(abs(t1 - WoI(2)));
    idx1 = min(i0,i1):max(i0,i1);
end
if isempty(idx2)
    [~, j0] = min(abs(t2 - WoI(1)));
    [~, j1] = min(abs(t2 - WoI(2)));
    idx2 = min(j0,j1):max(j0,j1);
end


% Ensure non-empty before plotting
hold(axWoI,'on'); %[output:772fd63a]
if ~isempty(idx1)
    axWoIhP1 = plot(axWoI, t1(idx1), y1_p(idx1), '-', 'Color', LUBlue, 'LineWidth', 0.9); %[output:772fd63a]
end
if ~isempty(idx2)
    axWoIhP2 = plot(axWoI, t2(idx2), y2_p(idx2), '-', 'Color', LUCopper, 'LineWidth', 0.9); %[output:772fd63a]
end
xlabel(axWoI, 'Time [s]', 'Interpreter','latex'); %[output:772fd63a]
ylabel(axWoI, 'Overpressure [kPa]', 'Interpreter','latex'); %[output:772fd63a]
legend(axWoI,[axWoIhP1,axWoIhP2], ... %[output:772fd63a]
    {'Pressure (DAQ-1) '+ ch1_p,'Pressure (DAQ-4) ' + ch2_p}, ... %[output:772fd63a]
    'Location','northeast', 'Interpreter','latex'); %[output:772fd63a]
title(axWoI, sprintf('Temporal Window of Interest: [%.3f, %.3f] s', WoI(1), WoI(2)), 'Interpreter','latex'); %[output:772fd63a]
xlim(axWoI, WoI);  %[output:772fd63a]
% --- Dynamic axis limits (5% padding) ---
